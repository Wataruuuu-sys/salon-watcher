# Copy to .env (git-ignored) and fill in as needed. docker-compose reads it for batch / api.

# 1 = fake Places / Threads / Claude / HPB clients (only honoured with APP_ENV=local).
# Remove it and fill in the keys below to call the real external APIs.
FAKE_EXTERNAL=1
PLACES_API_KEY=
THREADS_ACCESS_TOKEN=

# Real mode (FAKE_EXTERNAL off): the batch calls Claude through Amazon Bedrock and always needs
# AWS_REGION (or BEDROCK_REGION) AND AWS credentials, whichever credential path you use.
# AWS_REGION=ap-northeast-1
# Credentials, either a profile (also uncomment the ~/.aws mount on the batch service in docker-compose.yml) ...
# AWS_PROFILE=
# ... or access keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional overrides (defaults: anthropic.claude-haiku-5-5, AWS_REGION):
# CLASSIFY_MODEL_ID=
# BEDROCK_REGION=
