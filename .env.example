# Copy to .env (git-ignored) and fill in as needed. docker-compose reads it for batch / api / localstack.

# LocalStack auth token (free Hobby account). Empty is fine: db / api / frontend do not need LocalStack.
LOCALSTACK_AUTH_TOKEN=

# 1 = fake Places / Threads / Claude / HPB clients (only honoured with APP_ENV=local).
# Remove it and fill in the keys below to call the real external APIs.
FAKE_EXTERNAL=1
PLACES_API_KEY=
ANTHROPIC_API_KEY=
THREADS_ACCESS_TOKEN=
